# Isolated QA environment — COPY to qa/.env.qa (which is git-ignored) and fill the password.
# NEVER put a production credential here. The DB name must stay disposable (jpw_qa).
#
# The password below is a LOCAL-ONLY throwaway for the jpw_qa role you create on your
# local Postgres (or the one the Docker container is launched with). It is not a secret.

DATABASE_URL=postgresql+psycopg2://jpw_qa:CHANGE_ME_local_only@localhost:5432/jpw_qa
JWT_SECRET_KEY=qa-local-only-not-a-secret-0123456789abcdef

# Safety flags (asserted by qa/scripts/check_db_safety.py and the app itself)
DEPLOYED=false
DEBUG=true
PAYMENT_PROVIDER=none
PAYMENT_ENVIRONMENT=test
OTP_DEV_ECHO=true
STORAGE_BACKEND=local
OCR_PROVIDER=none

# Single worker so the in-process chat/voice registry works without Redis.
WEB_CONCURRENCY=1

# The app is served here; 8099 is deliberately NOT the 8000/8420 dev ports.
FRONTEND_BASE_URL=http://127.0.0.1:8099
CORS_ORIGINS=http://127.0.0.1:8099,http://localhost:8099

# Only if running the chat/voice E2E scripts; use a throwaway Redis DB index.
# REDIS_URL=redis://localhost:6379/15

# Consumed by the Playwright suite + verify_* scripts as the server base URL.
JPW_QA_BASE=http://127.0.0.1:8099
JPW_BASE=http://127.0.0.1:8099

# Force UTF-8 stdout for the QA process on Windows. Several verify_* scripts print
# check labels containing non-ASCII (e.g. the "→" in verify_m1); Windows' default
# cp1252 console raises UnicodeEncodeError and the child exits non-zero (run_all
# then reports a spurious FAIL). CI/Linux is already UTF-8, so this is a no-op there.
PYTHONUTF8=1
