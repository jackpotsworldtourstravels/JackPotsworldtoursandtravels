# Copy to deploy/staging/backend.staging.env ON THE STAGING SERVER ONLY. Never commit the real file.
# HDFC UAT credentials ONLY. No live HDFC credentials. No production DATABASE_URL (the compose
# file builds DATABASE_URL itself from stack.env, pointing at the staging postgres container).

JWT_SECRET_KEY=<generate: openssl rand -hex 32; must differ from production>
FRONTEND_BASE_URL=https://uat.jackpotsworldtours.com
CORS_ORIGINS=https://uat.jackpotsworldtours.com

# Role separation. The app container is serve-only and connects with the runtime
# DATABASE_URL (built by the compose file from the POSTGRES_* in stack.env).
# Migrations run as a SEPARATE step via deploy/migrate.sh.
# REQUIRED on this DEPLOYED host (DEPLOYED=true): the migration step FAILS CLOSED
# unless MIGRATION_DATABASE_URL is supplied — it will NOT fall back to the runtime
# DATABASE_URL. Supply the migration/owner credential to that step ONLY (never in
# this file / the app env). Forward it with a BARE `-e MIGRATION_DATABASE_URL` so
# the value never appears on the command line (no `ps`/trace/log leak), e.g.:
#   export MIGRATION_DATABASE_URL="postgresql+psycopg2://<migration_role>:<pw>@postgres:5432/<db>"
#   docker compose -f docker-compose.staging.yml --env-file stack.env \
#     run --rm --no-deps -e MIGRATION_DATABASE_URL --entrypoint /app/deploy/migrate.sh app
# (The single-role fallback to DATABASE_URL applies ONLY to local dev / CI, where
# DEPLOYED is unset/false.)

STORAGE_BACKEND=local

# Customer sign-in is passwordless and the code is EMAILED on a deployed host (an unconfigured
# or failing send is a 503), so staging needs working SMTP for the test customer's mailbox.
SMTP_HOST=<owner's SMTP host>
SMTP_PORT=587
SMTP_USERNAME=<...>
SMTP_PASSWORD=<...>
SMTP_FROM_EMAIL=<a staging sender on the company domain; the mailbox uat-payments@jackpotsworldtours.com is PROPOSED, not yet created>
SMTP_FROM_NAME=JackPots Staging

# The first start on a deployed host generates a random admin password and prints it once to
# the app log (docker compose logs app). Or set ADMIN_SEED_PASSWORD yourself here.

# ---- Payments: HDFC UAT only ----
PAYMENT_PROVIDER=hdfc
PAYMENT_ENVIRONMENT=test
PAYMENT_MODE=real
ALLOW_SANDBOX_PAYMENTS=true
# Fill in AFTER the staging test customer exists (their staging id). Never a production id.
SANDBOX_PAYMENT_CUSTOMER_IDS=
HDFC_SG_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_SG_MERCHANT_ID=<HDFC UAT merchant id>
HDFC_SG_CLIENT_ID=<HDFC UAT client id>
HDFC_SG_API_KEY=<HDFC UAT api key>
HDFC_SG_RESPONSE_KEY=<HDFC UAT response key, if issued>
HDFC_SG_RETURN_URL=https://uat.jackpotsworldtours.com/api/payments/hdfc/return
# A pair created for staging; it must match what the HDFC dashboard is later told to send.
HDFC_SG_WEBHOOK_USERNAME=<staging-only username>
HDFC_SG_WEBHOOK_PASSWORD=<staging-only password>
PAYMENT_SWEEP_ENABLED=true
