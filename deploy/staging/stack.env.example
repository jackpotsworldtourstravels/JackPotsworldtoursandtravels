# Copy to deploy/staging/stack.env ON THE STAGING SERVER ONLY. Never commit the real file.
# Placeholders only: generate real values on the server.

SITE_DOMAIN=uat.jackpotsworldtours.com

# Staging database, created by the postgres container on first start. Its OWN credentials.
POSTGRES_DB=jpw_staging
POSTGRES_USER=jpw_staging
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>

# Basic Auth for the human-facing site. The value is a bcrypt hash, not the password.
#   docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
STAGING_BASIC_AUTH_USER=<choose a user name>
STAGING_BASIC_AUTH_HASH=<paste the hash; in this file a literal $ must be written as $$>
