# /etc/systemd/system/jackpots-backend.service
# Runs the FastAPI backend under gunicorn with uvicorn workers, restarts on failure/boot.

[Unit]
Description=JackPots World Tours & Travels backend (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/jackpots/backend
EnvironmentFile=/opt/jackpots/backend/.env
ExecStart=/opt/jackpots/backend/venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
