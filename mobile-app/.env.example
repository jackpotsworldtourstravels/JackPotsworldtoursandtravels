# JackpotsWorld mobile app - environment template.
#
# Copy to `.env.local` (git-ignored) and edit. Expo inlines every variable that
# starts with EXPO_PUBLIC_ into the JavaScript bundle at build time, so NOTHING
# in this file is secret: anyone can read it out of an installed app. Never put
# a database URL, a payment key secret, a supplier credential or a JWT secret
# here. The app talks to the website's backend API and nothing else.

# Base URL of the backend API: scheme + host (+ port), no trailing path.
# Production and staging builds MUST be https:// - the app refuses to start
# otherwise. Plain http:// is accepted only in development builds.
#
#   Android emulator -> the host machine:   http://10.0.2.2:8000
#   iOS simulator    -> the host machine:   http://127.0.0.1:8000
#   Physical phone   -> your PC's LAN IP:   http://192.168.1.20:8000
#   Production:                             https://<your production domain>
#
# Left unset, development builds fall back to the emulator addresses above;
# release builds throw at startup instead of guessing.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# development | staging | production. Only affects labels and diagnostics; the
# backend decides everything that matters (prices, availability, payments).
EXPO_PUBLIC_APP_ENV=development
