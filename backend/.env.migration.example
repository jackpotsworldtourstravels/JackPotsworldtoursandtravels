# TEMPLATE — copy to backend/.env.migration ON THE DEPLOY HOST ONLY (chmod 600).
# The real backend/.env.migration is gitignored (matches backend/.env.*) and must
# NEVER be committed.
#
# PURPOSE: the MIGRATION/owner database credential used ONLY by the separate
# migration step (deploy/migrate.sh, run by deploy/redeploy.sh step 3b). It is
# deliberately NOT placed in backend/.env, because that file is the application
# container's env_file — putting the migration credential there would expose it
# to the serve-only runtime process. redeploy.sh sources THIS file and forwards
# the value to the one-off migration container with a bare `-e MIGRATION_DATABASE_URL`
# (the value never appears on the command line).
#
# The runtime app keeps using the least-privilege DATABASE_URL (in backend/.env);
# it never reads MIGRATION_DATABASE_URL. On a deployed host this value is REQUIRED —
# migrations fail closed without it (no fallback to DATABASE_URL).

MIGRATION_DATABASE_URL=postgresql+psycopg2://<migration_owner_role>:<password>@<db-host>:5432/<database>
