# PostgreSQL connection string (Neon/Railway/local). Example Neon format:
# postgresql+psycopg2://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/jackpotsworldtours

# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Where the deployed frontend lives — used to build the absolute link in reset-password emails
FRONTEND_BASE_URL=https://YOUR_DOMAIN

# SMTP for password-reset emails. Leave SMTP_HOST unset to skip sending (a warning
# is logged instead) — useful for local dev without real email credentials.
# Gmail example: host=smtp.gmail.com, port=587, username=you@gmail.com,
# password=an App Password (not your normal Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JackPots World Tours & Travels

# Mark this host as dev/test: login OTPs are logged and returned in the API
# response instead of being emailed. Everything else SMTP does — the contact
# form, password-reset links — is unaffected.
# LOCAL AND CI ONLY — never set this on a deployed host: it hands anyone who
# knows a password the second factor too. Off by default. It exists because
# tests/config.py signs in by reading `dev_otp` from the login response, and
# configuring SMTP (which the contact form needs) would otherwise stop the
# whole suite from being able to log in.
OTP_DEV_ECHO=false

# ---------------------------------------------------------------------------
# Taking money from a customer (B2C checkout). Off by default.
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER: none | razorpay | mock
#   none      no online payment offered; the checkout shows its honest
#             "no payment is taken yet" notice (the current behaviour)
#   razorpay  Razorpay Payment Gateway - INR, UPI Intent (mobile) / UPI QR
#   mock      takes no money and can never report a success. Local and CI only;
#             refused unless PAYMENT_ENVIRONMENT is test/sandbox/local.
PAYMENT_PROVIDER=none

# test | live. A live host logs a warning on every boot that it takes real
# money. This does NOT pick the credentials - the keys below do that.
PAYMENT_ENVIRONMENT=test

# Seconds the provider gets to answer before an attempt is abandoned.
PAYMENT_TIMEOUT_SECONDS=20

# Razorpay credentials. Required when PAYMENT_PROVIDER=razorpay.
#
# ONLY RAZORPAY_KEY_ID MAY EVER REACH A BROWSER - it is the publishable key
# Razorpay's own checkout script needs. RAZORPAY_KEY_SECRET signs API calls and
# RAZORPAY_WEBHOOK_SECRET verifies incoming deliveries; neither is ever sent to
# a page, returned by an endpoint, or written to a log.
#
# Test-mode keys start rzp_test_; live keys start rzp_live_. The webhook secret
# is set by you in the Razorpay Dashboard when you create the webhook, and must
# match this value exactly or every delivery will be rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RUNNING RAZORPAY LOCALLY WITHOUT BREAKING THE TEST SUITE
# tests/verify_payments.py drives the gateway through PAYMENT_PROVIDER=mock: it
# signs webhooks with the mock secret and expects a provider it can stub. Setting
# the three keys above and PAYMENT_PROVIDER=razorpay in THIS file reconfigures
# that suite too, which then posts invalid signatures at the real adapter and
# opens real test-mode orders on the account.
#
# So keep this file on mock and put the Razorpay settings in `.env.razorpay`
# (gitignored by `backend/.env.*`), then:
#
#     python run_razorpay.py
#
# It exports them into the process environment -- which pydantic ranks above
# this file -- so they apply to that one server and nothing else. It also
# refuses any key that does not start with rzp_test_.
#
# A LAPTOP CANNOT RECEIVE A WEBHOOK. Razorpay cannot deliver to 127.0.0.1, so
# nothing would ever confirm a booking on its own. That is what
# POST /api/customer/package-bookings/{ref}/reconcile is for: it runs the same
# verify_and_capture the webhook runs, on demand, and the payment screen calls
# it while polling. Point a public tunnel at /api/webhooks/payments/razorpay
# when you want to exercise the webhook path itself.

# The deferred-event sweep. A money-moving webhook that could not be verified
# when it arrived (provider unreachable, payment still in flight) stays
# deferred; this is what comes back for it. Turning it off means those events
# are never retried and a customer who paid is never confirmed.
PAYMENT_SWEEP_ENABLED=true
PAYMENT_SWEEP_INTERVAL_MINUTES=5
PAYMENT_SWEEP_BATCH_SIZE=100

# Where booking documents (passport/visa scans) are written. Never inside a
# served directory. In the Docker image this defaults to /app/uploads — on a
# host with no persistent disk that directory is wiped on every restart, so
# point it at a mounted volume before taking real customer uploads.
# UPLOAD_ROOT=/app/uploads
# MAX_UPLOAD_MB=10

# Storage backend for those documents: "local" (UPLOAD_ROOT above) or "s3".
# Use s3 on any host where the server is disposable — an EC2 instance refresh
# takes its disk with it, and these are identity documents.
#
# The bucket MUST be private (Block Public Access on). Downloads are proxied
# through the authenticated endpoint in both modes; nothing here ever issues a
# presigned URL. Credentials come from the instance's IAM role — do not put
# access keys in this file.
# STORAGE_BACKEND=s3
# S3_BUCKET=jackpotsworld-documents
# S3_REGION=ap-south-1
# S3_PREFIX=documents
# S3_SSE=AES256
# UPLOAD_ROOT is still used in s3 mode, as the scratch directory an upload is
# streamed to before it is sent on. It needs room for one file, not for all.

# Optional: control the admin account created by the 0003_seed_admin migration.
# If ADMIN_SEED_PASSWORD is not set, a random password is generated and printed
# once to the migration output — change it after your first login either way.
# ADMIN_SEED_EMAIL=admin@jackpotsworldtours.com
# ADMIN_SEED_PASSWORD=
