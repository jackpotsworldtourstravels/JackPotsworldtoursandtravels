# PostgreSQL connection string (Neon/Railway/local). Example Neon format:
# postgresql+psycopg2://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/jackpotsworldtours

# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Where the deployed frontend lives — used to build the absolute link in reset-password emails
FRONTEND_BASE_URL=https://YOUR_DOMAIN

# SMTP for password-reset emails. Leave SMTP_HOST unset to skip sending (a warning
# is logged instead) — useful for local dev without real email credentials.
# Gmail example: host=smtp.gmail.com, port=587, username=you@gmail.com,
# password=an App Password (not your normal Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JackPots World Tours & Travels

# Where booking documents (passport/visa scans) are written. Never inside a
# served directory. In the Docker image this defaults to /app/uploads — on a
# host with no persistent disk that directory is wiped on every restart, so
# point it at a mounted volume before taking real customer uploads.
# UPLOAD_ROOT=/app/uploads
# MAX_UPLOAD_MB=10

# Storage backend for those documents: "local" (UPLOAD_ROOT above) or "s3".
# Use s3 on any host where the server is disposable — an EC2 instance refresh
# takes its disk with it, and these are identity documents.
#
# The bucket MUST be private (Block Public Access on). Downloads are proxied
# through the authenticated endpoint in both modes; nothing here ever issues a
# presigned URL. Credentials come from the instance's IAM role — do not put
# access keys in this file.
# STORAGE_BACKEND=s3
# S3_BUCKET=jackpotsworld-documents
# S3_REGION=ap-south-1
# S3_PREFIX=documents
# S3_SSE=AES256
# UPLOAD_ROOT is still used in s3 mode, as the scratch directory an upload is
# streamed to before it is sent on. It needs room for one file, not for all.

# Optional: control the admin account created by the 0003_seed_admin migration.
# If ADMIN_SEED_PASSWORD is not set, a random password is generated and printed
# once to the migration output — change it after your first login either way.
# ADMIN_SEED_EMAIL=admin@jackpotsworldtours.com
# ADMIN_SEED_PASSWORD=
