.git
.gitignore
.claude

# Local virtualenv — the image installs its own from requirements.txt, and
# copying a 136 MB Windows venv into a Linux image would only break it.
backend/venv
backend/.venv
**/__pycache__
*.pyc

# Secrets and customer documents never enter the image.
backend/.env
uploads

# The Expo mobile app is its own project. The Dockerfile only COPYs backend/ and
# frontend/, but the build context is the whole repo, so without this a local
# `docker build` would upload mobile-app/node_modules to the daemon first.
mobile-app

tests
docs
deploy/README.md
README.md
*.dump
